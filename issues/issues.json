  "decisions": [
    {
      "id": "D1",
      "question": "首页「今日 3 件事」由谁生成？",
      "decision": "后端按当期六维短板 + 待办（体检券 / 测评 / 方案）动态生成；无个人数据时降级为「完成首次六维测评」。",
      "why": "六维短板是首页唯一能驱动复测的抓手，固定文案上线两周即失效。",
      "issues": [
        "XJ-201",
        "XJ-305"
      ],
      "status": "decided"
    },
    {
      "id": "D2",
      "question": "徽章数量与命名是否够用？",
      "decision": "定稿 24 枚（坚持 8 / 探索 8 / 分享 8），命名与解锁条件见 docs/07 §3；运营扩量只加数据行，不改结构。",
      "why": "24 枚覆盖「每天能拿 / 主动探索 / 对外分享」三类动机，是首次上线的最小完整集。",
      "issues": [
        "XJ-301",
        "XJ-303",
        "XJ-403"
      ],
      "status": "decided"
    },
    {
      "id": "D3",
      "question": "接力棒范围？未绑定家人时入口如何展示？",
      "decision": "仅限已绑定家人；未绑定时展示引导去绑定的空状态，不展示接力内容。",
      "why": "健康数据属敏感信息，跨家庭传递合规风险高；空状态本身也是家人绑定的转化入口。",
      "issues": [
        "XJ-301",
        "XJ-304",
        "XJ-402"
      ],
      "status": "decided"
    },
    {
      "id": "D4",
      "question": "盲盒知识卡内容源？",
      "decision": "内容团队供稿，AI 仅出草稿且必须过合规审核；页面固定标注「不构成医学建议」。",
      "why": "知识卡是唯一会被用户当结论转发的内容，必须走人工审核；免责标注是健康类内容的合规底线。",
      "issues": [
        "XJ-304",
        "XJ-404"
      ],
      "status": "decided"
    },
    {
      "id": "D5",
      "question": "周报是否需要定时推送？",
      "decision": "本期只做站内展示，不做订阅消息推送；推送需求另开 Issue，不并入本轮。",
      "why": "订阅消息需用户逐次授权且模板审核周期不可控，会拖住周报上线。",
      "issues": [
        "XJ-302",
        "XJ-405"
      ],
      "status": "decided"
    },
    {
      "id": "D6",
      "question": "A 级夜色金是否全站强制？",
      "decision": "默认全站切换夜色金，同时在「我的 → 设置」保留浅色可切换选项；用户显式选择优先于等级默认。",
      "why": "夜色金是 A 级的身份感来源，但 45+ 用户在强光下阅读浅色更舒适，两者都要满足。",
      "issues": [
        "XJ-202",
        "XJ-204"
      ],
      "status": "decided"
    },
    {
      "id": "D7",
      "question": "门店集章册其余 5 家门店数据来源？",
      "decision": "本期只上 1 家（五月花店），但数据结构与页面按 N 家设计，不做任何单店硬编码。",
      "why": "数据结构一次做对，门店上线属运营节奏而非开发节奏，不应阻塞开发。",
      "issues": [
        "XJ-301",
        "XJ-304",
        "XJ-406"
      ],
      "status": "decided"
    },
    {
      "id": "D8",
      "question": "首屏是否保留数字滚动？",
      "decision": "保留，但压缩到 ≤600ms 完成；`mo-off` / `mo-lite` 档位与乐龄模式下直接显示最终值。",
      "why": "数字滚动是首页「活起来」感最强的单点，600ms 内不影响秒开感。",
      "issues": [
        "XJ-201",
        "XJ-207",
        "XJ-401",
        "XJ-801"
      ],
      "status": "decided"
    },
    {
      "id": "D9",
      "question": "「省流模式」是否对用户可见？",
      "decision": "在「我的 → 设置」放显式开关，默认值为「跟随设备自动判定」，用户可强制满效 / 轻效 / 关闭。",
      "why": "低端机用户需要能自救；默认自动判定让多数人不必理解这个概念。",
      "issues": [
        "XJ-706"
      ],
      "status": "decided"
    },
    {
      "id": "D10",
      "question": "乐龄模式是否完全不给动效覆盖入口？",
      "decision": "强制 `mo-off`，不提供任何覆盖入口（含隐藏入口）。",
      "why": "乐龄用户是眩晕与误触风险最高的人群，不给入口是产品责任，不是设计洁癖。",
      "issues": [
        "XJ-203",
        "XJ-802"
      ],
      "status": "decided"
    },
    {
      "id": "D11",
      "question": "`--mo-rise` 用 16px 还是 12px？",
      "decision": "定为 16px。",
      "why": "16px 在 375pt 宽下仍属克制范围但位移可感，12px 在小屏上几乎看不出入场；上线后若收到集中「太跳」反馈再降。",
      "issues": [
        "XJ-103",
        "XJ-802"
      ],
      "status": "decided"
    },
    {
      "id": "D12",
      "question": "阴影 e2 是否引入？",
      "decision": "引入 e2，但仅用于悬停态与浮层，卡片默认仍为 e1。",
      "why": "只在「元素脱离静态层」时加第三层，既建立纵深又不让页面显脏。",
      "issues": [
        "XJ-103"
      ],
      "status": "decided"
    },
    {
