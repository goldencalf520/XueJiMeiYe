{
  "name": "xueji-health",
  "private": true,
  "version": "0.1.0",
  "description": "雪姬美业六维健康平台（黑客松 MVP）",
  "scripts": {
    "dev:server": "pnpm --filter xueji-server dev",
    "dev:admin": "pnpm --filter xueji-admin dev",
    "dev:h5": "pnpm --filter xueji-miniapp dev:h5",
    "dev:mp": "pnpm --filter xueji-miniapp dev:mp",
    "build:server": "pnpm --filter xueji-server build",
    "build:admin": "pnpm --filter xueji-admin build",
    "build:h5": "pnpm --filter xueji-miniapp build:h5",
    "build:mp": "pnpm --filter xueji-miniapp build:mp",
    "check:mp": "bash scripts/ci-check.sh",
    "db:reset": "pnpm --filter xueji-server db:reset"
  },
  "packageManager": "pnpm@10.33.2",
  "pnpm": {
    "overrides": {
      "unconfig": "7.3.2"
    }
  }
}